<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ThatsLit.Sync</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.3110.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local References Configuration -->
    <ReferencesPath>$(ProjectDir)..\References</ReferencesPath>
    <BepInExReferencesPath>$(ReferencesPath)\BepInEx</BepInExReferencesPath>
    <SPTReferencesPath>$(ReferencesPath)\SPT</SPTReferencesPath>
    <GameReferencesPath>$(ReferencesPath)\Game</GameReferencesPath>
    <FikaReferencesPath>$(ReferencesPath)\Fika</FikaReferencesPath>
    <AssemblySearchPaths>$(BepInExReferencesPath);$(SPTReferencesPath);$(GameReferencesPath);$(FikaReferencesPath);</AssemblySearchPaths>
    
    <!-- Fallback SPT Path Configuration (for deployment only) -->
    <EFTPath Condition="'$(EFTPath)' == ''">..\..</EFTPath>
    <PluginsPath>$(EFTPath)\BepInEx\plugins</PluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx References -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExReferencesPath)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExReferencesPath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- SPT References -->
    <Reference Include="spt-reflection">
      <HintPath>$(SPTReferencesPath)\spt-reflection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Game References -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameReferencesPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(GameReferencesPath)\Comfort.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(GameReferencesPath)\ItemComponent.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameReferencesPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameReferencesPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.TerrainModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameReferencesPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Optional Fika Reference -->
    <Reference Include="Fika.Core" Condition="Exists('$(FikaReferencesPath)\Fika.Core.dll')">
      <HintPath>$(FikaReferencesPath)\Fika.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Core Plugin Reference (built from local project) -->
    <Reference Include="ThatsLit.Core">
      <HintPath>..\ThatsLit.Core\bin\$(Configuration)\net48\ThatsLit.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Core">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Data">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Drawing">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.IO.Compression.FileSystem">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Numerics">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Runtime.Serialization">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Project Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\ThatsLit.Core\ThatsLit.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyOutput" AfterTargets="Build">
    <Message Text="Copying new build to dist" Importance="High" />

    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).dll"
      DestinationFolder="$(PluginsPath)\ThatsLit" />

    <Message Text="Copied build files" Importance="High" />
  </Target>
</Project>